@model IEnumerable<NgoThiLe_2410900046.Models.Ngothilestudent>

@{
    ViewData["Title"] = "Danh sách sinh viên";
}

<div class="container mt-4">
    <h2 class="text-primary mb-3">Danh sách sinh viên</h2>

    <div class="mb-3">
        <a asp-action="Create" class="btn btn-success shadow-sm">
            + Thêm sinh viên
        </a>
    </div>

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-bordered table-striped table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.NgothileName)</th>
                    <th>@Html.DisplayNameFor(model => model.NgothileGender)</th>
                    <th>@Html.DisplayNameFor(model => model.NgothileBirthday)</th>
                    <th>@Html.DisplayNameFor(model => model.NgothileEmail)</th>
                    <th>@Html.DisplayNameFor(model => model.NgothilePhone)</th>
                    <th>@Html.DisplayNameFor(model => model.NgothileActive)</th>
                    <th class="text-center" style="width: 200px;">Thao tác</th>
                </tr>
            </thead>
            <tbody class="bg-white">
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(model => item.NgothileName)</td>
                        <td>@Html.DisplayFor(model => item.NgothileGender)</td>
                        <td>@Html.DisplayFor(model => item.NgothileBirthday)</td>
                        <td>@Html.DisplayFor(model => item.NgothileEmail)</td>
                        <td>@Html.DisplayFor(model => item.NgothilePhone)</td>
                        <td>
                            @if (item.NgothileActive == true)
                            {
                                <span class="badge bg-primary">True</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">False</span>
                            }
                        </td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Sửa</a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Xem</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Xóa</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>