<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - NTLLab7</title>
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
	@RenderSection("Css", required: false)
</head>
<body>
	<nav class="navbar navbar-inverse">
		<div class="container">
			<ul class="nav navbar-nav">
				<li><a asp-area="Admins" asp-controller="Dashboard" asp-action="Index">Trang chủ</a></li>
				<li><a asp-area="Admins" asp-controller="Dashboard" asp-action="About">Giới thiệu</a></li>
				<li><a asp-area="Admins" asp-controller="Dashboard" asp-action="Contact">Liên hệ</a></li>
			</ul>
		</div>
	</nav>
	<div class="container">
		@RenderBody()
	</div>
	<script src="~/lib/jquery/dist/jquery.min.js"></script>
	<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	@RenderSection("Scripts", required: false)
</body>
</html>