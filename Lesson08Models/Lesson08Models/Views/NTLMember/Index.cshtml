@model IEnumerable<NTLLesson08Models.Models.NTLMember>

@{
    ViewData["Title"] = "Danh sách thành viên";
}
<div class="card p-3">
    <div class="card-header">
        <h1>@ViewData["Title"]</h1>
        <a asp-action="NTLCreate">Thêm mới</a>
    </div>

    <div class="card-body" >
        <table class="table">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.NTLMemberId)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.NTLUserName)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.NTLPassword)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.NTLFullName)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.NTLEmail)
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
             @foreach (var item in Model){
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.NTLMemberId)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.NTLUserName)
                    </td>
                    <td>
                         @Html.DisplayFor(modelItem => item.NTLPassword)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.NTLFullName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.NTLEmail)
                    </td>
                    <td>
                        @Html.ActionLink("Sửa", "NTLEdit", new { id = item.NTLMemberId  }) |
                        @Html.ActionLink("Xem chi tiết", "NTLDetails", new { id = item.NTLMemberId }) |
                        @Html.ActionLink("Xóa", "NTLDelete", new { id = item.NTLMemberId})
                    </td>
                </tr>
        }
            </tbody>
        </table>
    </div>
</div>