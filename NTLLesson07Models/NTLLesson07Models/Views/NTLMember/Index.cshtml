@model IEnumerable<NTLLesson07Models.Models.DataModels.NTLMember>

@{
    ViewData["Title"] = "Danh sách thành viên";
}
<div class="card p-3">
    <h1>@ViewData["Title"]</h1>

    <p>
        <a asp-action="Create" class="btn btn-primary my-1">Thêm mới</a>
    </p>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.NTLMemberId)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.NTLUserName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.NTLPassword)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.NTLFullName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.NTLEmail)
                </th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.NTLMemberId)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.NTLUserName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.NTLPassword)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.NTLEmail)
                    </td>
                    <td>
                        @Html.ActionLink("Edit", "Edit", new { /* id=item.PrimaryKey */ }) |
                        @Html.ActionLink("Details", "Details", new { /* id=item.PrimaryKey */ }) |
                        @Html.ActionLink("Delete", "Delete", new { /* id=item.PrimaryKey */ })
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
