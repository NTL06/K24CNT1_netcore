@model NTLLab6_EF.Models.NTLProduct

@{
	ViewData["Title"] = "Create Product";
}

<h2>Create Product</h2>

<div class="row">
	<div class="col-md-8">
		<form asp-action="Create" method="post" enctype="multipart/form-data">            
			@Html.AntiForgeryToken()

			@if (TempData["ModelErrors"] != null)
			{
				<div class="alert alert-danger">@TempData["ModelErrors"]</div>
			}
			<div asp-validation-summary="ModelOnly" class="text-danger"></div>

			<div class="mb-3">
				<label asp-for="NTLName" class="form-label"></label>
				<input asp-for="NTLName" class="form-control" />
				<span asp-validation-for="NTLName" class="text-danger"></span>
			</div>

			<div class="mb-3">
				<label class="form-label">Image</label>
				<input type="file" name="imageFile" class="form-control" />
			</div>

			<div class="row">
				<div class="col-md-6">
					<div class="mb-3">
						<label asp-for="NTLPrice" class="form-label"></label>
						<input asp-for="NTLPrice" class="form-control" />
						<span asp-validation-for="NTLPrice" class="text-danger"></span>
					</div>
				</div>
				<div class="col-md-6">
					<div class="mb-3">
						<label asp-for="NTLSalePrice" class="form-label"></label>
						<input asp-for="NTLSalePrice" class="form-control" />
					</div>
				</div>
			</div>

			<div class="mb-3">
				<label asp-for="NTLDescriptions" class="form-label"></label>
				<textarea asp-for="NTLDescriptions" class="form-control"></textarea>
			</div>

			<div class="row">
				<div class="col-md-6">
					<label asp-for="NTLCategoryId" class="form-label"></label>
					<select asp-for="NTLCategoryId" asp-items="ViewBag.CategoryId" class="form-select"></select>
				</div>
				<div class="col-md-6">
					<label asp-for="NTLStatus" class="form-label"></label>
					<input asp-for="NTLStatus" class="form-control" />
				</div>
			</div>

			<div class="mt-3">
				<input type="submit" value="Save" class="btn btn-success" />
				<a asp-action="Index" class="btn btn-secondary">Back to List</a>
			</div>
		</form>
	</div>
</div>

@section Scripts {
	@{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
