@model IEnumerable<NTLLab6_EF.Models.NTLProduct>

@{
	ViewData["Title"] = "Product List";
}

<h2>Product List</h2>

<p>
	<a class="btn btn-sm btn-success" asp-action="Create">Create New</a>
</p>

<table class="table table-striped table-bordered">
	<thead>
		<tr>
			<th>Name</th>
			<th>Image</th>
			<th>Price</th>
			<th>SalePrice</th>
			<th>Status</th>
			<th>CreatedDate</th>
			<th>Category</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
	@foreach(var item in Model)
	{
		<tr>
			<td>@item.NTLName</td>
			<td>
				@if (!string.IsNullOrEmpty(item.NTLImage))
				{
					<img src="@Url.Content("~/" + item.NTLImage)" alt="" style="height:60px;" />
				}
			</td>
			<td>@item.NTLPrice</td>
			<td>@item.NTLSalePrice</td>
			<td>@item.NTLStatus</td>
			<td>@item.CreatedDate</td>
			<td>@item.nTLCategory?.NTLName</td>
			<td>
				<a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@item.NTLId">Edit</a>
				<a class="btn btn-sm btn-info text-white" asp-action="Details" asp-route-id="@item.NTLId">Details</a>
				<a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.NTLId">Delete</a>
			</td>
		</tr>
	}
	</tbody>
</table>
