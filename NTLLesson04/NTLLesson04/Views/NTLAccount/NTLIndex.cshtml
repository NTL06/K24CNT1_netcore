
@{
	ViewData["Title"] = "Danh sách tài khoản";
	var nTLAccount=ViewBag.NTLAccount;
}
<div class="row">
	@foreach (var item in nTLAccount)
	{
		<div class="col-md-4 my-3">
			<div class="card">
				<div class="card-body">
					<div class="img">
						<img src="@item.Avatar" alt="@item.Name" class="w-100"/>
					</div>
					<div class="">
						<h3>@item.Name</h3>
						<p>@item.Bio</p>
						<a asp-route="NTLProfile" asp-route-id="@item.Id" class="btn btn-success btn-block"> Profile</a>
					</div>
				</div>
			</div>
		</div>
	}
</div>

